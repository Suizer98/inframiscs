<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Aws.SecretsManager</PackageId>
    <Version>1.0.1</Version>
    <Description>Loads AWS Secrets Manager values into IConfiguration.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="test/**" />
    <Compile Remove="api/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.SecretsManager" Version="4.0.100.16" />
    <PackageReference Include="AWSSDK.SSO" Version="4.0.100.16" />
    <PackageReference Include="AWSSDK.SSOOIDC" Version="4.0.100.16" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.0" />
  </ItemGroup>

</Project>
