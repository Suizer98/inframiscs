<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <directoryBrowse enabled="true" />
    <staticContent>
      <remove fileExtension=".atbx" />
      <mimeMap fileExtension=".atbx" mimeType="application/octet-stream" />
    </staticContent>
  </system.webServer>
</configuration>